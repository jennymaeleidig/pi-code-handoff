{
  "name": "pi-code-handoff",
  "version": "3.0.0",
  "description": "Aider-style hand-off blocks for pi: a validated diff, whole file or shell command the human copies out of the tool's row",
  "type": "module",
  "license": "CC0-1.0",
  "keywords": [
    "pi-package",
    "pi-extension",
    "diff",
    "patch",
    "code-handoff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jennymaeleidig/pi-code-handoff.git"
  },
  "homepage": "https://github.com/jennymaeleidig/pi-code-handoff#readme",
  "bugs": {
    "url": "https://github.com/jennymaeleidig/pi-code-handoff/issues"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "GLOSSARY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,js,json,jsonc,md,yml,yaml}": "prettier --write"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^24.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
